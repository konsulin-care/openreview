---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const entries = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Blog — OpenReview">
  <h1 class="mb-8 text-3xl font-bold">Blog</h1>

  <ul class="space-y-6">
    {
      entries.map((entry) => (
        <li>
          <a
            href={`/blog/${entry.id}`}
            class="block rounded-lg border border-gray-200 bg-white p-4 shadow-sm transition hover:shadow-md"
          >
            <time class="text-sm text-gray-500">
              {entry.data.pubDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
            <h2 class="mt-1 text-lg font-semibold">{entry.data.title}</h2>
            <p class="text-gray-600">{entry.data.description}</p>
            {entry.data.tags.length > 0 && (
              <div class="mt-2 flex gap-2">
                {entry.data.tags.map((tag) => (
                  <span class="rounded bg-gray-100 px-2 py-0.5 text-xs text-gray-600">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
