---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const entries = (await getCollection("docs")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Docs — OpenReview">
  <h1 class="mb-8 text-3xl font-bold">Documentation</h1>

  <ul class="space-y-4">
    {
      entries.map((entry) => (
        <li>
          <a
            href={`/docs/${entry.id}`}
            class="block rounded-lg border border-gray-200 bg-white p-4 shadow-sm transition hover:shadow-md"
          >
            <h2 class="text-lg font-semibold">{entry.data.title}</h2>
            <p class="text-gray-600">{entry.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
