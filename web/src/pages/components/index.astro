---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("components");

const grouped = entries.reduce(
  (acc, entry) => {
    const cat = entry.data.category;
    if (!acc[cat]) acc[cat] = [];
    acc[cat].push(entry);
    return acc;
  },
  {} as Record<string, typeof entries>,
);

const statusColors: Record<string, string> = {
  stable: "bg-green-100 text-green-800",
  experimental: "bg-yellow-100 text-yellow-800",
  planned: "bg-gray-100 text-gray-600",
};
---

<BaseLayout title="Components — OpenReview">
  <h1 class="mb-8 text-3xl font-bold">Components</h1>

  {
    Object.entries(grouped).map(([category, items]) => (
      <section class="mb-8">
        <h2 class="mb-4 text-xl font-semibold capitalize">{category}</h2>
        <ul class="space-y-4">
          {items.map((entry) => (
            <li class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
              <div class="flex items-center gap-3">
                <h3 class="font-medium">{entry.data.name}</h3>
                <span class={`rounded px-2 py-0.5 text-xs font-medium ${statusColors[entry.data.status]}`}>
                  {entry.data.status}
                </span>
              </div>
              <p class="mt-1 text-sm text-gray-600">{entry.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
