---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/layout/Breadcrumbs.astro";
---

<BaseLayout title="OpenReview">
  <div id="app-root">
    <div class="flex items-center justify-center py-12">
      <div class="h-8 w-8 animate-spin rounded-full border-4 border-blue-600 border-t-transparent"></div>
    </div>
  </div>

  <script>
    import { resolveEngineState, VIEWS } from "../lib/engine-state";
    import { initWizard } from "../lib/wizard";

    document.addEventListener("DOMContentLoaded", async () => {
      const appRoot = document.getElementById("app-root");
      if (!appRoot) return;

      const state = await resolveEngineState();
      console.log("[OpenReview] engine state:", state);

      // Update breadcrumb visibility
      const breadcrumb = document.getElementById("breadcrumb-home");
      if (breadcrumb) {
        breadcrumb.hidden = state !== "healthy";
      }

      // Render view from object lookup
      appRoot.innerHTML = VIEWS[state]();

      // Initialize wizard interaction layer for onboarding views
      if (state === "unconfigured" || state === "not-initialized") {
        initWizard(appRoot);
      }
    });
  </script>
</BaseLayout>
