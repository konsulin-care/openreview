---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/ui/Card.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="OpenReview">
  <section class="py-12">
    <h1 class="mb-4 text-4xl font-bold">OpenReview</h1>
    <p class="mb-8 text-lg text-gray-600">
      Local-first systematic literature review screening.
      Your data stays on your machine.
    </p>

    <div class="grid gap-6 sm:grid-cols-2">
      <Card variant="interactive" padding="lg">
        <Button variant="ghost" href="/docs">
          <div class="text-left">
            <h2 class="mb-2 text-xl font-semibold">Docs</h2>
            <p class="text-gray-600">Setup guides, workflow documentation, and reference material.</p>
          </div>
        </Button>
      </Card>

      <Card variant="interactive" padding="lg">
        <Button variant="ghost" href="/blog">
          <div class="text-left">
            <h2 class="mb-2 text-xl font-semibold">Blog</h2>
            <p class="text-gray-600">Announcements, design decisions, and project updates.</p>
          </div>
        </Button>
      </Card>

      <Card variant="interactive" padding="lg">
        <Button variant="ghost" href="/faq">
          <div class="text-left">
            <h2 class="mb-2 text-xl font-semibold">FAQ</h2>
            <p class="text-gray-600">Answers to common questions about OpenReview.</p>
          </div>
        </Button>
      </Card>

      <Card variant="interactive" padding="lg">
        <Button variant="ghost" href="/components">
          <div class="text-left">
            <h2 class="mb-2 text-xl font-semibold">Components</h2>
            <p class="text-gray-600">UI component library and design system documentation.</p>
          </div>
        </Button>
      </Card>
    </div>
  </section>
</BaseLayout>
