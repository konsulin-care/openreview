---
interface Props {
  code: string;
  lang?: string;
  filename?: string;
}

const { code, lang, filename } = Astro.props;

// Escape HTML entities for safe rendering
const escapedCode = code.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
---

<figure class="my-4">
  {filename && (
    <figcaption class="mb-1 rounded-t-lg bg-gray-800 px-4 py-2 text-xs text-gray-300">
      {filename}
    </figcaption>
  )}
  <pre class="overflow-x-auto rounded-lg bg-gray-950 p-4 text-sm text-gray-100"><code set:html={escapedCode} /></pre>
  <button
    type="button"
    class="mt-2 text-xs text-gray-500 hover:text-gray-700"
    onclick={`navigator.clipboard.writeText(${JSON.stringify(code)})`}
  >
    Copy
  </button>
</figure>
