---
interface Heading {
  depth: number;
  text: string;
  slug: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
---

<nav aria-label="Table of contents" class="text-sm">
  <ul class="space-y-1">
    {headings.map((heading) => (
      <li class:list={[heading.depth > 2 && "ml-4"]}>
        <a
          href={`#${heading.slug}`}
          class="text-gray-600 hover:text-blue-600"
        >
          {heading.text}
        </a>
      </li>
    ))}
  </ul>
</nav>
