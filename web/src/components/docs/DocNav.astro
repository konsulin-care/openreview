---
interface Props {
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
}

const { prev, next } = Astro.props;
---

<nav class="mt-8 flex items-center justify-between border-t border-gray-200 pt-4">
  {prev ? (
    <a href={prev.href} class="group flex items-center text-sm text-gray-600 hover:text-blue-600">
      <span class="mr-2 transition-transform group-hover:-translate-x-1">&larr;</span>
      {prev.title}
    </a>
  ) : <div />}
  {next ? (
    <a href={next.href} class="group flex items-center text-sm text-gray-600 hover:text-blue-600">
      {next.title}
      <span class="ml-2 transition-transform group-hover:translate-x-1">&rarr;</span>
    </a>
  ) : <div />}
</nav>
