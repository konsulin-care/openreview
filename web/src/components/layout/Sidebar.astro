---
/**
 * Global sidebar navigation component.
 * Sticky, full-height, collapsible with localStorage persistence.
 */
import { Icon } from "astro-icon/components";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navItems = [
  { href: "/", label: "Dashboard", icon: "lucide:layout-dashboard" },
  { href: "/projects", label: "Projects", icon: "lucide:folder" },
  { href: "/docs", label: "Docs", icon: "lucide:file-text" },
  { href: "/blog", label: "Blog", icon: "lucide:pen-line" },
  { href: "/faq", label: "FAQ", icon: "lucide:help-circle" },
  { href: "/components", label: "Components", icon: "lucide:boxes" },
];

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<aside
  data-collapsed="false"
  class="sidebar sticky top-0 flex h-screen w-60 flex-col border-r border-gray-200 bg-white transition-all duration-200"
>
  {/* Top bar: logo + toggle */}
  <div class="flex items-center justify-between border-b border-gray-100 px-4 py-3">
    <span class="sidebar-label text-lg font-bold text-gray-900">OpenReview</span>
    <button
      type="button"
      data-sidebar-toggle
      class="rounded p-1 text-gray-500 hover:bg-gray-100 hover:text-gray-700"
      aria-label="Toggle sidebar"
    >
      <Icon name="lucide:panel-right-open" class="toggle-icon h-5 w-5" data-icon-expanded="lucide:panel-right-open" data-icon-collapsed="lucide:panel-right-close" />
    </button>
  </div>

  {/* Primary nav */}
  <nav class="flex-1 overflow-y-auto px-2 py-3">
    <ul class="flex flex-col gap-1">
      {navItems.map(({ href, label, icon }) => {
        const active = isActive(href);
        return (
          <li>
            <a
              href={href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "flex items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors",
                active
                  ? "bg-blue-50 font-medium text-blue-600"
                  : "text-gray-700 hover:bg-gray-50 hover:text-gray-900",
              ]}
            >
              <Icon name={icon} class="h-5 w-5 shrink-0" />
              <span class="sidebar-label">{label}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  {/* Bottom: Settings */}
  <div class="border-t border-gray-200 px-2 py-3">
    <a
      href="/settings"
      aria-current={currentPath.startsWith("/settings") ? "page" : undefined}
      class:list={[
        "flex items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors",
        currentPath.startsWith("/settings")
          ? "bg-blue-50 font-medium text-blue-600"
          : "text-gray-700 hover:bg-gray-50 hover:text-gray-900",
      ]}
    >
      <Icon name="lucide:settings" class="h-5 w-5 shrink-0" />
      <span class="sidebar-label">Settings</span>
    </a>
  </div>
</aside>

<style>
  /* Collapsed state: hide labels, narrow width */
  .sidebar[data-collapsed="true"] {
    width: 4rem;
  }
  .sidebar[data-collapsed="true"] .sidebar-label {
    display: none;
  }

  /* Body class for main content margin */
  :global(body.sidebar-collapsed) {
    --sidebar-margin: 4rem;
  }
  :global(body:not(.sidebar-collapsed)) {
    --sidebar-margin: 15rem;
  }
</style>

<script>
  const STORAGE_KEY = "openreview:sidebarCollapsed";
  const sidebar = document.querySelector(".sidebar") as HTMLElement | null;
  const toggle = document.querySelector("[data-sidebar-toggle]") as HTMLButtonElement | null;
  const toggleIcon = document.querySelector(".toggle-icon") as SVGElement | null;

  function setCollapsed(collapsed: boolean) {
    if (!sidebar) return;
    sidebar.dataset.collapsed = String(collapsed);
    document.body.classList.toggle("sidebar-collapsed", collapsed);

    // Swap icon
    if (toggleIcon) {
      const iconName = collapsed
        ? toggleIcon.dataset.iconCollapsed
        : toggleIcon.dataset.iconExpanded;
      if (iconName) toggleIcon.setAttribute("data-lucide", iconName);
    }
  }

  // Initialize from localStorage
  const stored = localStorage.getItem(STORAGE_KEY);
  if (stored === "true") {
    setCollapsed(true);
  }

  toggle?.addEventListener("click", () => {
    const collapsed = sidebar?.dataset.collapsed === "true";
    const next = !collapsed;
    localStorage.setItem(STORAGE_KEY, String(next));
    setCollapsed(next);
  });
</script>
