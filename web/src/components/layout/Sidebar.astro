---
/**
 * Global sidebar navigation component.
 * Sticky, full-height, collapsible with localStorage persistence.
 */
import { Icon } from "astro-icon/components";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navItems = [
  { href: "/", label: "Dashboard", icon: "lucide:layout-dashboard" },
  { href: "/docs", label: "Docs", icon: "lucide:file-text" },
  { href: "/blog", label: "Blog", icon: "lucide:pen-line" },
  { href: "/faq", label: "FAQ", icon: "lucide:help-circle" },
  { href: "/components", label: "Components", icon: "lucide:boxes" },
];

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<aside
  data-collapsed="false"
  class="sidebar sticky top-0 flex h-screen flex-col border-r border-gray-200 bg-white transition-all duration-200"
>
  {/* Top bar: logo + toggle */}
  <div class="flex items-center justify-between border-b border-gray-100 px-4 py-3">
    <span class="sidebar-label text-lg font-bold text-gray-900">OpenReview</span>
    <button
      type="button"
      data-sidebar-toggle
      class="rounded p-1 text-gray-500 hover:bg-gray-100 hover:text-gray-700"
      aria-label="Toggle sidebar"
    >
      <Icon name="lucide:panel-right-open" class="toggle-icon h-5 w-5" data-icon-expanded="lucide:panel-right-open" data-icon-collapsed="lucide:panel-right-close" />
    </button>
  </div>

  {/* Primary nav */}
  <nav class="flex-1 overflow-y-auto px-2 py-3">
    <ul class="flex flex-col gap-1">
      {navItems.map(({ href, label, icon }) => {
        const active = isActive(href);
        return (
          <li>
            <a
              href={href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "flex items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors",
                active
                  ? "bg-blue-50 font-medium text-blue-600"
                  : "text-gray-700 hover:bg-gray-50 hover:text-gray-900",
              ]}
            >
              <Icon name={icon} class="h-5 w-5 shrink-0" />
              <span class="sidebar-label">{label}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  {/* Bottom: Settings */}
  <div class="border-t border-gray-200 px-2 py-3">
    <a
      href="/settings"
      aria-current={currentPath.startsWith("/settings") ? "page" : undefined}
      class:list={[
        "flex items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors",
        currentPath.startsWith("/settings")
          ? "bg-blue-50 font-medium text-blue-600"
          : "text-gray-700 hover:bg-gray-50 hover:text-gray-900",
      ]}
    >
      <Icon name="lucide:settings" class="h-5 w-5 shrink-0" />
      <span class="sidebar-label">Settings</span>
    </a>
  </div>
</aside>

<div class="sidebar-backdrop fixed inset-0 z-40 bg-black/30"></div>

<style>
  /* Desktop: width controlled by collapsed state */
  .sidebar {
    width: 15rem;
  }

  /* Collapsed state: hide labels, narrow width */
  .sidebar[data-collapsed="true"] {
    width: 4rem;
  }
  .sidebar[data-collapsed="true"] .sidebar-label {
    display: none;
  }

  /* Body class for main content margin */
  :global(body.sidebar-collapsed) {
    --sidebar-margin: 4rem;
  }
  :global(body:not(.sidebar-collapsed)) {
    --sidebar-margin: 15rem;
  }

  /* Backdrop hidden by default */
  .sidebar-backdrop {
    display: none;
  }

  /* Mobile: sidebar always fixed, main always offset by collapsed width */
  @media (max-width: 767px) {
    .sidebar {
      touch-action: pan-y;
      position: fixed;
      top: 0;
      left: 0;
      width: 4rem;
    }

    /* Expanded: widen overlay */
    .sidebar[data-collapsed="false"] {
      width: 15rem;
      z-index: 50;
    }

    /* Backdrop shown only when expanded on mobile */
    .sidebar[data-collapsed="false"] ~ .sidebar-backdrop {
      display: block;
    }

    :global(main) {
      margin-left: 4rem;
      overflow-x: hidden;
    }
  }
</style>

<script>
  const STORAGE_KEY = "openreview:sidebarCollapsed";
  const MOBILE_BREAKPOINT = 768;
  const SWIPE_THRESHOLD = 50;

  const sidebar = document.querySelector(".sidebar") as HTMLElement | null;
  const toggle = document.querySelector("[data-sidebar-toggle]") as HTMLButtonElement | null;
  const toggleIcon = document.querySelector(".toggle-icon") as SVGElement | null;
  const backdrop = document.querySelector(".sidebar-backdrop") as HTMLElement | null;

  function setCollapsed(collapsed: boolean) {
    if (!sidebar) return;
    sidebar.dataset.collapsed = String(collapsed);
    document.body.classList.toggle("sidebar-collapsed", collapsed);

    // Swap icon
    if (toggleIcon) {
      const iconName = collapsed
        ? toggleIcon.dataset.iconCollapsed
        : toggleIcon.dataset.iconExpanded;
      if (iconName) toggleIcon.setAttribute("data-lucide", iconName);
    }
  }

  function isMobile(): boolean {
    return window.innerWidth < MOBILE_BREAKPOINT;
  }

  // Initialize: always collapsed on mobile, respect localStorage on desktop
  const stored = localStorage.getItem(STORAGE_KEY);
  if (isMobile()) {
    setCollapsed(true);
  } else if (stored === "true") {
    setCollapsed(true);
  }

  // Toggle button
  toggle?.addEventListener("click", () => {
    const collapsed = sidebar?.dataset.collapsed === "true";
    const next = !collapsed;
    localStorage.setItem(STORAGE_KEY, String(next));
    setCollapsed(next);
  });

  // Backdrop click collapses sidebar (mobile)
  backdrop?.addEventListener("click", () => {
    localStorage.setItem(STORAGE_KEY, "true");
    setCollapsed(true);
  });

  // Swipe gesture handling
  let touchStartX = 0;

  function handleSwipeStart(x: number) {
    touchStartX = x;
  }

  function handleSwipeEnd(x: number) {
    if (!isMobile()) return;
    const deltaX = x - touchStartX;
    if (Math.abs(deltaX) < SWIPE_THRESHOLD) return;

    if (deltaX < 0) {
      // Swipe left → collapse
      localStorage.setItem(STORAGE_KEY, "true");
      setCollapsed(true);
    } else {
      // Swipe right → expand
      localStorage.setItem(STORAGE_KEY, "false");
      setCollapsed(false);
    }
  }

  // Swipe on sidebar
  sidebar?.addEventListener("touchstart", (e) => {
    handleSwipeStart(e.touches[0].clientX);
  });
  sidebar?.addEventListener("touchend", (e) => {
    handleSwipeEnd(e.changedTouches[0].clientX);
  });

  // Swipe on main content area (body)
  document.body.addEventListener("touchstart", (e) => {
    handleSwipeStart(e.touches[0].clientX);
  });
  document.body.addEventListener("touchend", (e) => {
    handleSwipeEnd(e.changedTouches[0].clientX);
  });
</script>
