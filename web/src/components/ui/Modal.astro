---
interface Props {
  id: string;
  title?: string;
}

const { id, title } = Astro.props;
---

<dialog id={id} class="rounded-lg bg-white p-6 shadow-xl max-w-lg backdrop:bg-black/50">
  <div class="flex items-center justify-between">
    {title && <h2 class="text-lg font-semibold">{title}</h2>}
    <form method="dialog">
      <button type="submit" class="ml-auto text-gray-400 hover:text-gray-600" aria-label="Close">
        &times;
      </button>
    </form>
  </div>
  <div class="mt-4">
    <slot />
  </div>
</dialog>

<button
  type="button"
  onclick={`document.getElementById('${id}').showModal()`}
  class="hidden"
>
  <slot name="trigger" />
</button>
