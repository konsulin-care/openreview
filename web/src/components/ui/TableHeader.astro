---
import { TABLE_HEADER_CLASSES, TABLE_CELL_CLASSES } from "./table-utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const classes = className
  ? `${TABLE_HEADER_CLASSES} ${TABLE_CELL_CLASSES} ${className}`
  : `${TABLE_HEADER_CLASSES} ${TABLE_CELL_CLASSES}`;
---

<th class={classes}>
  <slot />
</th>
