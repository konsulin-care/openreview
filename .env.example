# OpenReview Engine Configuration
# Copy this file to .env and customize as needed.

# CORS Origins
# Comma-separated list of allowed origins for cross-origin requests.
# Empty or unset = allow all origins (default).
# Examples:
#   OPENREVIEW_CORS_ORIGINS=http://localhost:4321
#   OPENREVIEW_CORS_ORIGINS=http://localhost:4321,https://myapp.com
OPENREVIEW_CORS_ORIGINS=
